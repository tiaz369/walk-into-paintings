  "artists": [
    { "id": "van-gogh", "cover": ["sunflowers"], "name": { "zh": "梵高", "en": "Vincent van Gogh" }, "dates": { "zh": "1853–1890", "en": "1853–1890" },
      "bio": {"zh": "文森特·梵高（1853–1890），荷兰画家。他将近27岁才开始画画，短短十年留下了大量作品。1888年他来到法国南部的阿尔勒，在那里画出了许多最著名的画。", "en": "Vincent van Gogh (1853–1890) was a Dutch painter. He began painting at around 27 and left a huge body of work in just ten years. In 1888 he moved to Arles in the south of France, where he painted many of his best-known works."} },
    { "id": "vermeer",  "cover": ["pearl-earring", "milkmaid"], "name": { "zh": "维米尔", "en": "Johannes Vermeer" }, "dates": { "zh": "1632–1675", "en": "1632–1675" }, "bio": { "zh": "约翰内斯·维米尔（1632–1675），荷兰画家，一生都在代尔夫特生活和创作。他留下的画作只有约35幅，以描绘室内的光线著称。", "en": "Johannes Vermeer (1632–1675) was a Dutch painter who lived and worked in Delft all his life. Only about 35 of his paintings survive, famous for their rendering of light in quiet interiors." } },
    { "id": "van-eyck", "cover": ["arnolfini"], "name": { "zh": "扬·凡·艾克", "en": "Jan van Eyck" }, "dates": { "zh": "约1390–1441", "en": "c. 1390–1441" }, "bio": { "zh": "扬·凡·艾克（约1390–1441），尼德兰画家，主要在布鲁日工作，以极其精细的油画著称。", "en": "Jan van Eyck (c. 1390–1441) was a Netherlandish painter who worked mainly in Bruges, celebrated for the extraordinary detail of his oil paintings." } },
    { "id": "monet", "coverImage": { "src": "assets/artists/monet.jpg", "title": { "zh": "日出·印象", "en": "Impression, Sunrise" } },    "name": { "zh": "莫奈", "en": "Claude Monet" }, "dates": { "zh": "1840–1926", "en": "1840–1926" }, "bio": { "zh": "克劳德·莫奈（1840–1926），法国印象派最重要的风景画家。他生于巴黎，在勒阿弗尔长大。普法战争期间（1870–71）曾移居伦敦。1883年起住在吉维尼，晚年专注于在不同光线下反复画同一主题，比如干草堆、鲁昂大教堂和他自己的花园。", "en": "Claude Monet (1840–1926) was the leading French Impressionist landscape painter. Born in Paris, he grew up in Le Havre and moved to London during the Franco-Prussian War (1870–71). From 1883 he lived in Giverny, where he painted series of a single subject under different light: haystacks, Rouen Cathedral and his own garden." } },
    { "id": "seurat", "coverImage": { "src": "assets/artists/seurat.jpg", "title": { "zh": "大碗岛的星期天下午", "en": "A Sunday on La Grande Jatte — 1884" } },   "name": { "zh": "修拉", "en": "Georges Seurat" }, "dates": { "zh": "1859–1891", "en": "1859–1891" }, "bio": { "zh": "乔治·修拉（1859–1891），法国画家，生于巴黎，在巴黎美术学院接受过传统训练。他发明了用对比色小点作画的技法，后来被称为点彩派。他31岁就去世了。", "en": "Georges Seurat (1859–1891) was a French painter, born in Paris and trained at the École des Beaux-Arts. He developed a technique of painting in dots of contrasting colour, later known as pointillism. He died aged 31." } },
    { "id": "degas", "coverImage": { "src": "assets/artists/degas.jpg", "title": { "zh": "舞蹈课", "en": "The Dance Class" } },    "name": { "zh": "德加", "en": "Edgar Degas" }, "dates": { "zh": "1834–1917", "en": "1834–1917" }, "bio": { "zh": "埃德加·德加（1834–1917），法国画家，生于巴黎。他参加了印象派画展，以描绘芭蕾舞者著称。", "en": "Edgar Degas (1834–1917) was a French painter, born in Paris. He took part in the Impressionist exhibitions and is best known for his paintings of ballet dancers." } },
    { "id": "renoir", "coverImage": { "src": "assets/artists/renoir.jpg", "title": { "zh": "煎饼磨坊的舞会", "en": "Dance at Le Moulin de la Galette" } },   "name": { "zh": "雷诺阿", "en": "Pierre-Auguste Renoir" }, "dates": { "zh": "1841–1919", "en": "1841–1919" }, "bio": { "zh": "皮埃尔-奥古斯特·雷诺阿（1841–1919），法国画家。他和莫奈在学画时就是好友，是印象派的核心人物之一。19世纪80年代，他开始离开印象派，转向古典艺术。", "en": "Pierre-Auguste Renoir (1841–1919) was a French painter. He and Monet became friends as students, and he was one of the leading Impressionists. In the 1880s he began to move away from Impressionism towards classical art." } },
    { "id": "caillebotte", "coverImage": { "src": "assets/artists/caillebotte.jpg", "title": { "zh": "巴黎街道，雨天", "en": "Paris Street; Rainy Day" } }, "name": { "zh": "卡耶博特", "en": "Gustave Caillebotte" }, "dates": { "zh": "1848–1894", "en": "1848–1894" }, "bio": { "zh": "古斯塔夫·卡耶博特（1848–1894），法国画家，出身富裕家庭。他是印象派画家的朋友和支持者，1877年的印象派画展很大程度上是他组织的。他的巴黎街景线条清晰、结构严谨，和其他印象派画家很不一样。", "en": "Gustave Caillebotte (1848–1894) was a French painter from a wealthy family. A friend and supporter of the Impressionists, he largely organised their 1877 exhibition. His views of Paris, with their clear lines and strict structure, are quite unlike the work of his fellow Impressionists." } },
    { "id": "manet", "coverImage": { "src": "assets/artists/manet.jpg", "title": { "zh": "女神游乐厅的吧台", "en": "A Bar at the Folies-Bergère" } },    "name": { "zh": "马奈", "en": "Édouard Manet" }, "dates": { "zh": "1832–1883", "en": "1832–1883" }, "bio": { "zh": "爱德华·马奈（1832–1883），法国画家，生于巴黎。他是描绘现代生活的先驱，对印象派画家影响很深。", "en": "Édouard Manet (1832–1883) was a French painter, born in Paris. A pioneer in painting modern life, he had a deep influence on the Impressionists." } },
    { "id": "turner", "status": "planned", "name": { "zh": "特纳", "en": "J.M.W. Turner" }, "dates": { "zh": "1775–1851", "en": "1775–1851" }, "bio": null },
