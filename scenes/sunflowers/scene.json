  "cards": {
    "yellow": {
      "title": {
        "zh": "黄上加黄",
        "en": "Yellow on yellow"
      },
      "text": {
        "zh": "黄色的花、黄色的桌面、黄色的背景。他计划用这些画装饰房间，让整体成为\"一首蓝与黄的交响曲\"。",
        "en": "Yellow flowers, yellow table, yellow background. He planned these paintings to decorate a room as \"a symphony in blue and yellow\"."
      }
    },
    "signature": {
      "title": {
        "zh": "花瓶上的签名",
        "en": "The signature"
      },
      "text": {
        "zh": "他在花瓶上签了名：\"Vincent\"。",
        "en": "He signed his name on the vase: \"Vincent\"."
      }
    },
    "budwilt": {
      "title": {
        "zh": "从花苞到凋谢",
        "en": "From bud to wilting"
      },
      "text": {
        "zh": "十五朵向日葵，有的含苞，有的盛开，有的已经凋谢。",
        "en": "Fifteen sunflowers: some in bud, some in full bloom, some already wilting."
      }
    },
    "gauguin": {
      "title": {
        "zh": "给高更的房间",
        "en": "For Gauguin's room"
      },
      "text": {
        "zh": "这幅画是为黄房子的客房准备的，用来迎接高更。",
        "en": "This painting was made for the guest room of the Yellow House, to welcome Gauguin."
      }
    },
    "thick": {
      "title": {
        "zh": "厚厚的颜料",
        "en": "Thick paint"
      },
      "text": {
        "zh": "颜料涂得很厚，可以看到笔触的起伏。",
        "en": "The paint is laid on thickly; you can see the ridges of each brushstroke."
      }
    },
    "praise": {
      "title": {
        "zh": "高更的称赞",
        "en": "Gauguin's praise"
      },
      "text": {
        "zh": "高更很喜欢这幅画，称赞它完美体现了梵高的风格。",
        "en": "Gauguin admired it, praising it as a perfect example of Van Gogh's style."
      }
    }
  },
  "ending": {
    "unlockAfter": 3,
