  "cards": {
    "yellow": {
      "title": {
        "zh": "黄上加黄",
        "en": "Yellow on yellow"
      },
      "text": {
        "zh": "黄色的花、黄色的桌面、黄色的背景。他计划用这些画装饰房间，让整体成为\"一首蓝与黄的交响曲\"。",
        "en": "Yellow flowers, yellow table, yellow background. He planned these paintings to decorate a room as \"a symphony in blue and yellow\"."
      }
    },
    "signature": {
      "title": {
        "zh": "花瓶上的签名",
        "en": "The signature"
      },
      "text": {
        "zh": "他在花瓶上签了名：\"Vincent\"。",
        "en": "He signed his name on the vase: \"Vincent\"."
      }
    },
    "budwilt": {
      "title": {
        "zh": "从花苞到凋谢",
        "en": "From bud to wilting"
      },
      "text": {
        "zh": "十五朵向日葵，有的含苞，有的盛开，有的已经凋谢。",
        "en": "Fifteen sunflowers: some in bud, some in full bloom, some already wilting."
      }
    },
    "gauguin": {
      "title": {
        "zh": "给高更的房间",
        "en": "For Gauguin's room"
      },
      "text": {
        "zh": "这幅画是为黄房子的客房准备的，用来迎接高更。",
        "en": "This painting was made for the guest room of the Yellow House, to welcome Gauguin."
      }
    },
    "thick": {
      "title": {
        "zh": "厚厚的颜料",
        "en": "Thick paint"
      },
      "text": {
        "zh": "颜料涂得很厚，可以看到笔触的起伏。",
        "en": "The paint is laid on thickly; you can see the ridges of each brushstroke."
      }
    },
    "praise": {
      "title": {
        "zh": "高更与向日葵",
        "en": "Gauguin and the sunflowers"
      },
      "text": {
        "zh": "高更很喜欢这幅画。和梵高同住时，他还画了一幅《画向日葵的梵高》，现藏阿姆斯特丹梵高博物馆。",
        "en": "Gauguin admired this painting. While living with Van Gogh, he painted \"Van Gogh Painting Sunflowers\", now in the Van Gogh Museum, Amsterdam."
      }
    }
  },
  "ending": {
    "unlockAfter": 3,
    "acts": [
      {
        "image": "images/sunflowers.jpg",
        "alt": {
          "zh": "梵高《向日葵》1888",
          "en": "Vincent van Gogh, Sunflowers, 1888"
        },
        "caption": {
          "zh": "1888年8月 · 伦敦国家美术馆",
          "en": "August 1888 · The National Gallery, London"
        },
        "title": {
          "zh": "等待高更",
          "en": "Waiting for Gauguin"
        },
        "text": {
          "zh": "1888年8月，梵高画了一组向日葵，用来装饰黄房子的客房，迎接高更。",
          "en": "In August 1888, Van Gogh painted a group of sunflowers to decorate the Yellow House guest room for Gauguin."
        }
      },
      {
        "title": {
          "zh": "一场争执",
          "en": "A quarrel"
        },
        "text": {
          "zh": "高更离开阿尔勒后，想要一幅向日葵来换他留下的习作，梵高很不高兴。",
          "en": "After leaving Arles, Gauguin asked for one of the sunflower paintings in exchange for studies he had left behind. Van Gogh was upset."
        }
      },
      {
        "title": {
          "zh": "来到伦敦",
          "en": "In London"
        },
        "text": {
          "zh": "1924年，伦敦国家美术馆从梵高家人手中买下了这幅画。",
          "en": "In 1924, the National Gallery in London bought this painting from Van Gogh's family."
        }
      }
    ],
    "final": {
      "zh": "向日葵，在某种意义上属于我。",
      "en": "The sunflower is mine, in a way."
    },
    "finalBy": {
      "zh": "—— 梵高",
      "en": "— Van Gogh"
    },
