  "cards": {
    "terrace": {
      "title": {
        "zh": "同一个露台",
        "en": "The same terrace"
      },
      "text": {
        "zh": "这是沙图富尔奈斯餐厅的露台。就在画这幅画之前不久，雷诺阿在同一个地方画了《游艇上的午宴》。",
        "en": "This is the terrace of the Maison Fournaise at Chatou. Shortly before, Renoir had painted *Luncheon of the Boating Party* in the very same place."
      },
      "links": [
        {
          "scene": "boating-party",
          "href": "../boating-party/",
          "label": {
            "zh": "《游艇上的午宴》",
            "en": "Luncheon of the Boating Party"
          }
        }
      ]
    },
    "hat": {
      "title": {
        "zh": "红帽子",
        "en": "The red hat"
      },
      "text": {
        "zh": "年长的女子戴着一顶鲜红色的帽子，是整幅画最亮的一点颜色。",
        "en": "The older girl wears a bright red hat, the most vivid touch of colour in the painting."
      }
    },
    "basket": {
      "title": {
        "zh": "毛线篮",
        "en": "The basket of wool"
      },
      "text": {
        "zh": "前景放着一个篮子，里面装着彩色的毛线团。",
        "en": "In the foreground is a basket filled with balls of coloured wool."
      }
    },
    "boats": {
      "title": {
        "zh": "河上的船",
        "en": "Boats on the river"
      },
      "text": {
        "zh": "越过栏杆，能看到塞纳河边停着的划艇和帆船。",
        "en": "Beyond the railing, rowing boats and sailing boats are moored along the Seine."
      }
    },
    "struggle": {
      "title": {
        "zh": "“和树搏斗”",
        "en": "“Struggling with trees”"
      },
      "text": {
        "zh": "雷诺阿写信给朋友说，他因为这幅画不想去英国旅行：“我正在和树搏斗。”",
        "en": "Renoir wrote to a friend that he didn't want to leave for England because of this painting: “I am struggling with trees.”"
      }
    },
    "signature": {
      "title": {
        "zh": "签名",
        "en": "The signature"
      },
      "text": {
        "zh": "右下角用蓝色颜料签着“Renoir. 81.”。",
        "en": "Lower right, in blue paint, is the signature “Renoir. 81.”"
      }
    },
    "sisters": {
      "title": {
        "zh": "不是姐妹",
        "en": "Not sisters"
      },
      "text": {
        "zh": "“两姐妹”这个画名，是画商在1882年画展时取的。芝加哥艺术博物馆的研究认为，坐着的年轻女子叫让娜·达尔洛，旁边的小女孩并不是她的妹妹。",
        "en": "The title “Two Sisters” was given by the dealer for the 1882 exhibition. Research at the Art Institute of Chicago identifies the seated young woman as Jeanne Darlaud; the little girl beside her was not her sister."
      }
    }
  },
  "exclusive": {
    "_说明": "独家发现“走到栏杆边”（walkTo）：按按钮，从两个女孩身边慢慢走到露台栏杆旁，转头往外看塞纳河和船；走到栏杆边（自己走过去也算）显示卡片4。只是在空间里走动，不改变原画，所以不加“这是示意”。",
    "type": "walkTo",
