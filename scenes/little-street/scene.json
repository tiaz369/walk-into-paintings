  "cards": {
    "houses": {
      "title": {
        "zh": "两栋普通的房子",
        "en": "Two ordinary houses"
      },
      "text": {
        "zh": "画里只有鹅卵石街道上的两栋16世纪房子，没有全景，也没有发生什么大事。这在当时的城市风景画里很少见。",
        "en": "Just two 16th-century houses on a cobbled street: no panorama, no notable events. This was unusual for cityscapes of the time."
      }
    },
    "children": {
      "title": {
        "zh": "玩耍的孩子",
        "en": "Children at play"
      },
      "text": {
        "zh": "维米尔自己有11个孩子，但这两个玩耍的孩子，是他所有已知作品中唯一出现的孩子。",
        "en": "Vermeer had 11 children of his own, yet these two are the only children in any of his known works."
      },
      "link": {
        "href": "../../themes/?id=children",
        "label": {
          "zh": "看更多“孩子”",
          "en": "More: Children"
        }
      }
    },
    "sewing": {
      "title": {
        "zh": "门口做针线的女人",
        "en": "The woman sewing"
      },
      "text": {
        "zh": "门口有一个女人在做针线。如果画的真是弗拉明街，人们很想认为她就是维米尔的姑妈。",
        "en": "A woman sews in the doorway. If this is indeed Vlamingstraat, it is tempting to see her as Vermeer's aunt."
      }
    },
    "alley": {
      "title": {
        "zh": "小巷里的女人",
        "en": "The woman in the alley"
      },
      "text": {
        "zh": "旁边的小巷里，还有一个女人在忙家务。",
        "en": "In the alley beside the house, another woman is busy with housework."
      }
    },
    "tripe": {
      "title": {
        "zh": "牛肚门",
        "en": "The Tripe Gate"
      },
      "text": {
        "zh": "维米尔的姑妈靠卖牛肚养活孩子。房子旁边的门道，直到19世纪都被叫作“牛肚门”。",
        "en": "Vermeer's aunt supported her children by selling tripe. The passageway beside her house was known as the Tripe Gate into the 19th century."
      }
    },
    "today": {
      "title": {
        "zh": "今天的小街",
        "en": "The street today"
      },
      "text": {
        "zh": "今天，画里唯一还能认出来的，是右边那道门和通道。",
        "en": "Today, the only part still recognisable is the gate and passageway on the right."
      }
    }
  },
