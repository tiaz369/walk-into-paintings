  "cards": {
    "lamps": {
      "title": {
        "zh": "煤气灯",
        "en": "Gas lamps"
      },
      "text": {
        "zh": "梵高在信里写，他要在晚上、在煤气灯下画这间咖啡馆。",
        "en": "Van Gogh wrote that he would paint the café in the evening, by gas light."
      }
    },
    "colours": {
      "title": {
        "zh": "红与绿",
        "en": "Red and green"
      },
      "text": {
        "zh": "红墙和绿天花板不是写实，而是他特意选的颜色，用来表现人类\"可怕的激情\"。",
        "en": "The red walls and green ceiling are not realistic. He chose them to express the \"terrible passions of humanity\"."
      }
    },
    "billiard": {
      "title": {
        "zh": "台球桌",
        "en": "Billiard table"
      },
      "text": {
        "zh": "房间正中央是一张台球桌，旁边投下长长的影子。",
        "en": "A billiard table stands in the middle of the room, casting a long shadow."
      }
    },
    "slumped": {
      "title": {
        "zh": "趴着的客人",
        "en": "Slumped figures"
      },
      "text": {
        "zh": "角落里的客人趴在桌上。这是一家通宵营业的咖啡馆，没钱住旅馆的人会来这里过夜。",
        "en": "Customers slump over the tables. This café stayed open all night, and people with nowhere to sleep came here."
      }
    },
    "owner": {
      "title": {
        "zh": "站着的人",
        "en": "The standing man"
      },
      "text": {
        "zh": "画中站着的那位，据说就是咖啡馆的老板。",
        "en": "The standing figure is said to be the café's owner."
      }
    },
    "nights": {
      "title": {
        "zh": "三个通宵",
        "en": "Three nights"
      },
      "text": {
        "zh": "梵高连续三个晚上通宵作画，白天睡觉。",
        "en": "Van Gogh stayed up for three nights in a row to paint this, sleeping during the day."
      }
    }
  },
  "ending": {
    "unlockAfter": 3,
    "acts": [
      {
        "image": "images/night-cafe.jpg",
        "alt": {
          "zh": "梵高《夜间咖啡馆》1888",
          "en": "Vincent van Gogh, The Night Café, 1888"
        },
        "caption": {
          "zh": "1888年9月 · 耶鲁大学美术馆",
          "en": "September 1888 · Yale University Art Gallery"
        },
        "kicker": "ACT I",
        "title": {
          "zh": "第一幕 · 三个通宵",
          "en": "Three nights"
        },
        "text": {
          "zh": "1888年9月初，梵高在拉马丁广场的这家通宵咖啡馆里，连续三个晚上作画，白天睡觉。",
          "en": "In early September 1888, Van Gogh painted for three nights in a row in this all-night café on Place Lamartine, sleeping by day."
        }
      },
      {
        "kicker": "ACT II",
        "title": {
          "zh": "第二幕 · 一个危险的地方",
          "en": "A dangerous place"
        },
        "text": {
          "zh": "他在信里说，想用这幅画表达：咖啡馆是一个可能让人毁掉自己、发疯或犯罪的地方。",
          "en": "He wrote that he wanted to show the café as a place where one can ruin oneself, go mad or commit a crime."
        }
      },
      {
        "kicker": "ACT III",
        "title": {
          "zh": "第三幕 · 远行",
          "en": "A long journey"
        },
        "text": {
          "zh": "这幅画后来到了俄罗斯，属于收藏家莫罗佐夫，1918年被收归国有。之后它辗转来到美国，留给了耶鲁大学。2014年，法院裁定它继续留在耶鲁。",
          "en": "The painting later went to Russia, to the collector Morozov, and was nationalised in 1918. It then made its way to America and was left to Yale. In 2014, a court ruled it would stay there."
        }
      }
    ],
    "final": {
      "zh": "一个通宵的房间，走了很远的路。",
      "en": "A room that stayed up all night, and travelled far."
    },
