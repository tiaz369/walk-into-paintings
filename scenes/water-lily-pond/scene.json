  "cards": {
    "bridge": {
      "title": {
        "zh": "日本桥",
        "en": "The Japanese bridge"
      },
      "text": {
        "zh": "这座拱桥是莫奈自己建的，灵感来自他收藏的日本版画。",
        "en": "Monet built this humpback bridge himself, inspired by the Japanese prints in his collection."
      },
      "link": {
        "scene": "bedroom",
        "href": "../bedroom/?card=floor",
        "label": {
          "zh": "梵高也深受日本版画影响",
          "en": "Van Gogh was also deeply influenced by Japanese prints"
        }
      }
    },
    "floating": {
      "title": {
        "zh": "飘浮的桥",
        "en": "A floating bridge"
      },
      "text": {
        "zh": "桥横跨整幅画，两端被画框截断，看起来像飘浮在水面上。",
        "en": "The bridge spans the whole canvas and is cut off at both edges, so it seems to float above the water."
      }
    },
    "lilies": {
      "title": {
        "zh": "睡莲",
        "en": "The water lilies"
      },
      "text": {
        "zh": "暗粉色和矢车菊蓝的睡莲，在一片绿色中冒出来，有的含苞，有的盛开。",
        "en": "Dusky pink and cornflower-blue lilies break through the greens, in various stages of bloom."
      }
    },
    "reflection": {
      "title": {
        "zh": "倒影",
        "en": "The reflection"
      },
      "text": {
        "zh": "桥的倒影，在画面下方形成一道暗色的弧线。",
        "en": "The bridge's reflection forms a dark arc at the bottom of the picture."
      }
    },
    "view": {
      "title": {
        "zh": "在变的视角",
        "en": "A shifting view"
      },
      "text": {
        "zh": "我们像是在仰视这座桥，却又在俯视渐渐漂远的睡莲。",
        "en": "It is as though we are looking up at the bridge, but down on the water lilies floating into the distance."
      }
    },
    "accompaniment": {
      "title": {
        "zh": "只是陪衬",
        "en": "Just the accompaniment"
      },
      "text": {
        "zh": "莫奈说过，水上的花远不是画面的全部，它们只是陪衬。",
        "en": "Monet said the water flowers were far from the whole scene; really, they were just the accompaniment."
      }
    }
  },
