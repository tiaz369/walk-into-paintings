  "cards": {
    "light": {
      "title": {
        "zh": "晨光",
        "en": "Morning light"
      },
      "text": {
        "zh": "她在晨光里读信，身上还穿着蓝色的睡衣外套。",
        "en": "She reads in the morning light, still wearing her blue night jacket."
      }
    },
    "blue": {
      "title": {
        "zh": "珍贵的蓝",
        "en": "Precious blue"
      },
      "text": {
        "zh": "这种明亮的蓝色是群青，用青金石磨成粉制成，在当时非常昂贵。",
        "en": "This brilliant blue is ultramarine, made by grinding lapis lazuli into powder, an expensive pigment at the time."
      }
    },
    "letter": {
      "title": {
        "zh": "紧握的信",
        "en": "The letter"
      },
      "text": {
        "zh": "她用双手紧紧握着信。信里写了什么，维米尔没有告诉我们。",
        "en": "She holds the letter tightly with both hands. Vermeer gives no hint of what it says."
      }
    },
    "map": {
      "title": {
        "zh": "墙上的地图",
        "en": "The map"
      },
      "text": {
        "zh": "地图画的是荷兰与西弗里斯兰，是一张真实存在的地图，1620年由著名的地图出版商布劳出版。维米尔在别的画里也画过同一张。",
        "en": "The map shows Holland and West Friesland. It is a real map, published in 1620 by the famous mapmaker Willem Jansz Blaeu. Vermeer painted the same map in other works."
      },
      "link": {
        "href": "../../themes/?id=letters",
        "label": {
          "zh": "看更多“读信与书写”",
          "en": "More: Reading and writing letters"
        }
      }
    },
    "shadows": {
      "title": {
        "zh": "两道影子",
        "en": "Two shadows"
      },
      "text": {
        "zh": "地图挂钩的旋钮在墙上投下了两道影子，说明房间里可能还有第二个光源。",
        "en": "The knob of the map hanger casts two shadows on the wall, suggesting a second source of light."
      }
    },
    "blueShadows": {
      "title": {
        "zh": "蓝色的影子",
        "en": "Blue shadows"
      },
      "text": {
        "zh": "维米尔用淡灰色画她的皮肤，用浅蓝色画墙上的影子，这在当时很有创新。",
        "en": "Vermeer painted her skin with pale grey and the shadows on the wall with light blue, an innovative choice for his time."
      }
    }
  },
