  "cards": {
    "restaurant": {
      "title": {
        "zh": "河边的餐厅",
        "en": "A restaurant on the river"
      },
      "text": {
        "zh": "这是沙图的富尔奈斯餐厅，就在塞纳河边，划船的人可以直接把船划过来吃饭。",
        "en": "This is the Maison Fournaise in Chatou, right on the Seine, where rowers could paddle up and stop for a meal."
      }
    },
    "aline": {
      "title": {
        "zh": "艾琳和小狗",
        "en": "Aline and her dog"
      },
      "text": {
        "zh": "左下角逗着小狗的女子，是女裁缝艾琳·夏里戈。后来，她嫁给了雷诺阿。",
        "en": "The woman cooing at her little dog, lower left, is Aline Charigot, a seamstress. She later married Renoir."
      }
    },
    "caillebotte": {
      "title": {
        "zh": "反坐椅子的卡耶博特",
        "en": "Caillebotte, sitting backwards"
      },
      "text": {
        "zh": "右下角反坐在椅子上、望向艾琳的，是画家卡耶博特。他也是一位经验丰富的帆船手。",
        "en": "Sitting backwards on his chair at the lower right, looking across at Aline, is the painter Caillebotte, also a keen and experienced sailor."
      },
      "link": {
        "scene": "paris-street-rainy-day",
        "href": "../paris-street-rainy-day/",
        "label": {
          "zh": "卡耶博特画的巴黎",
          "en": "Caillebotte's own Paris"
        }
      }
    },
    "railing": {
      "title": {
        "zh": "靠在栏杆上的人",
        "en": "Leaning on the railing"
      },
      "text": {
        "zh": "靠在阳台栏杆上的魁梧男子，是餐厅老板的儿子小阿方斯·富尔奈斯。",
        "en": "The burly man leaning on the balcony railing is Alphonse Fournaise Jr., son of the restaurant's owner."
      }
    },
    "table": {
      "title": {
        "zh": "桌上的午餐",
        "en": "On the table"
      },
      "text": {
        "zh": "桌上还留着酒瓶、酒杯和一串葡萄，午餐已经吃完，大家还不想走。",
        "en": "Bottles, glasses and a bunch of grapes are still on the table: lunch is over, but no one wants to leave."
      }
    },
    "walks": {
      "title": {
        "zh": "各行各业的人",
        "en": "All walks of life"
      },
      "text": {
        "zh": "在这家餐厅，艺术家、演员、商人、上流社会的女士和工人，都可以坐下来吃饭、聊天。",
        "en": "Here, artists, actors, businessmen, society ladies and working people could all sit down to eat and talk."
      }
    }
  },
