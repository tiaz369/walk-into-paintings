  "cards": {
    "yellowhouse": {
      "title": {
        "zh": "黄房子对面",
        "en": "Across from the Yellow House"
      },
      "text": {
        "zh": "这是梵高住的黄房子正对面的公园。",
        "en": "This is the public garden directly across from Van Gogh's Yellow House."
      },
      "link": {
        "scene": "yellow-house",
        "href": "../yellow-house/",
        "label": {
          "zh": "走进《黄房子》",
          "en": "Step into The Yellow House"
        }
      }
    },
    "women": {
      "title": {
        "zh": "披着披肩的女人",
        "en": "Women in shawls"
      },
      "text": {
        "zh": "几位阿尔勒的妇女披着深色的披肩，低着头走过。",
        "en": "Several women of Arles walk past, wrapped in dark shawls, heads bowed."
      }
    },
    "fence": {
      "title": {
        "zh": "红色的栅栏",
        "en": "The red fence"
      },
      "text": {
        "zh": "她们身边是一道鲜红色的栅栏。",
        "en": "Beside them runs a bright red fence."
      }
    },
    "mistral": {
      "title": {
        "zh": "密史脱拉风",
        "en": "The mistral"
      },
      "text": {
        "zh": "画名里的“密史脱拉”，是法国南部一种又冷又强的风。",
        "en": "The “mistral” in the title is the strong, cold wind of southern France."
      },
      "link": {
        "scene": "wheatfield-cypresses",
        "href": "../wheatfield-cypresses/?card=mistral",
        "label": {
          "zh": "梵高画里的风",
          "en": "The wind in Van Gogh's painting"
        }
      }
    },
    "flat": {
      "title": {
        "zh": "平平的颜色",
        "en": "Flat colour"
      },
      "text": {
        "zh": "高更用大块平平的颜色作画，几乎看不出远近。他的构图经过精心安排，和梵高的即兴完全不同。",
        "en": "Gauguin painted in large areas of flat colour, with almost no sense of depth. His composition is carefully planned, quite unlike Van Gogh's spontaneity."
      }
    },
    "seventeen": {
      "title": {
        "zh": "十七幅画",
        "en": "Seventeen canvases"
      },
      "text": {
        "zh": "高更在阿尔勒和梵高同住的两个月里，一共画了17幅画，这是其中之一。",
        "en": "In the two months he lived with Van Gogh in Arles, Gauguin completed 17 canvases. This is one of them."
      }
    }
  },
  "exclusive": {
    "_说明": "独家发现“同一座花园，两种画法”：工具栏上的按钮，打开左右对比滑块。左边高更，右边梵高《埃滕花园的回忆》。两幅都是原作，不加“这是示意”。",
    "type": "compare",
    "label": {
      "zh": "同一座花园，两种画法",
      "en": "One garden, two ways"
    },
