  "cards": {
    "sunday": {
      "title": {
        "zh": "星期天下午",
        "en": "Sunday afternoon"
      },
      "text": {
        "zh": "星期天下午，巴黎人会打扮好来到这里，跳舞、喝酒、吃煎饼，一直玩到晚上。",
        "en": "On Sunday afternoons, Parisians dressed up and came here to dance, drink and eat galettes until evening."
      }
    },
    "galette": {
      "title": {
        "zh": "煎饼",
        "en": "The galette"
      },
      "text": {
        "zh": "“煎饼磨坊”的名字，来自这里的招牌点心：一种叫“galette”的煎饼。",
        "en": "The Moulin de la Galette took its name from its speciality, a kind of flat cake called a galette."
      }
    },
    "dapple": {
      "title": {
        "zh": "树下的光斑",
        "en": "Dappled light"
      },
      "text": {
        "zh": "阳光透过洋槐树的叶子，在人们的衣服和地上洒下一块块光斑。这是印象派很喜欢画的效果。",
        "en": "Sunlight filters through the acacia leaves, scattering patches of light on clothes and ground, an effect the Impressionists loved to paint."
      }
    },
    "stripes": {
      "title": {
        "zh": "条纹裙的女孩",
        "en": "The girl in stripes"
      },
      "text": {
        "zh": "前景中间穿条纹裙的女孩，据说是雷诺阿的模特让娜的姐姐埃丝特尔。",
        "en": "The girl in the striped dress in the centre foreground is said to be Estelle, the sister of Renoir's model Jeanne."
      }
    },
    "real": {
      "title": {
        "zh": "真实的人",
        "en": "Real people"
      },
      "text": {
        "zh": "和马奈画杜伊勒里花园一样，雷诺阿在画里放进了不少真实的人物肖像，有的是他的朋友。",
        "en": "As Manet had done in his painting of the Tuileries, Renoir included a number of real portraits, some of them his friends."
      }
    },
    "canvas": {
      "title": {
        "zh": "搬来搬去的画布",
        "en": "A canvas on the move"
      },
      "text": {
        "zh": "据他的朋友回忆，每到合适的时候，朋友们就帮雷诺阿把这张大画布从画室搬到舞场。",
        "en": "According to a friend, whenever the moment was right, Renoir's friends helped him carry this large canvas from his studio to the dance garden."
      }
    },
    "caillebotte": {
      "title": {
        "zh": "卡耶博特的画",
        "en": "Caillebotte's painting"
      },
      "text": {
        "zh": "1879年到1894年，这幅画属于画家卡耶博特。他去世后，它成为法国国家财产。",
        "en": "From 1879 to 1894, the painting belonged to the painter Caillebotte. After his death, it became the property of the French state."
      },
      "links": [
        {
          "scene": "paris-street-rainy-day",
          "href": "../paris-street-rainy-day/",
          "label": {
            "zh": "卡耶博特《巴黎街道，雨天》",
            "en": "Caillebotte's *Paris Street; Rainy Day*"
          }
        },
        {
          "scene": "gare-saint-lazare",
          "href": "../gare-saint-lazare/?card=caillebotte",
          "label": {
            "zh": "《圣拉扎尔火车站》也曾属于他",
            "en": "*The Saint-Lazare Station* was his too"
          }
        }
      ]
    }
  },
