  "ending": {
    "unlockAfter": 3,
    "acts": [
      {
        "image": "images/moulin-galette.jpg",
        "alt": {
          "zh": "雷诺阿《煎饼磨坊的舞会》1876，巴黎奥赛博物馆",
          "en": "Pierre-Auguste Renoir, Dance at Le Moulin de la Galette, 1876, Musée d'Orsay, Paris"
        },
        "caption": {
          "zh": "1876年 · 巴黎奥赛博物馆",
          "en": "1876 · Musée d'Orsay, Paris"
        },
        "kicker": "ACT I",
        "title": {
          "zh": "第一幕 · 蒙马特的星期天",
          "en": "A Sunday in Montmartre"
        },
        "text": {
          "zh": "19世纪70年代，蒙马特还像个乡村。山顶附近的煎饼磨坊，是附近居民和年轻人星期天下午跳舞的地方，也有不少画家来这里。",
          "en": "In the 1870s, Montmartre was still almost rural. The Moulin de la Galette, near the top of the hill, was where local people and young couples danced on Sunday afternoons, and where artists came too."
        }
      },
      {
        "image": "images/moulin-galette.jpg",
        "alt": {
          "zh": "雷诺阿《煎饼磨坊的舞会》1876，巴黎奥赛博物馆",
          "en": "Pierre-Auguste Renoir, Dance at Le Moulin de la Galette, 1876, Musée d'Orsay, Paris"
        },
        "caption": {
          "zh": "1876年 · 巴黎奥赛博物馆",
          "en": "1876 · Musée d'Orsay, Paris"
        },
        "kicker": "ACT II",
        "title": {
          "zh": "第二幕 · 在现场画",
          "en": "Painted on the spot"
        },
        "text": {
          "zh": "1876年，雷诺阿决定画下这里的舞会。他的朋友回忆，这幅画是完全在现场画的。不过雷诺阿还画了一幅较小的版本，到底哪一幅是在现场画的，至今仍有疑问。",
          "en": "In 1876, Renoir decided to paint the dancing here. A friend recalled that it was painted entirely on the spot. But Renoir also painted a smaller version, and which one was painted on site is still uncertain."
        }
      },
      {
        "image": "images/moulin-galette.jpg",
        "alt": {
          "zh": "雷诺阿《煎饼磨坊的舞会》1876，巴黎奥赛博物馆",
          "en": "Pierre-Auguste Renoir, Dance at Le Moulin de la Galette, 1876, Musée d'Orsay, Paris"
        },
        "caption": {
          "zh": "1876年 · 巴黎奥赛博物馆",
          "en": "1876 · Musée d'Orsay, Paris"
        },
        "kicker": "ACT III",
        "title": {
          "zh": "第三幕 · 从卡耶博特到奥赛",
          "en": "From Caillebotte to the Musée d'Orsay"
        },
        "text": {
          "zh": "这幅画后来属于卡耶博特。他去世后，它进入了法国国家收藏，先后挂在卢森堡博物馆和卢浮宫，1986年起在奥赛博物馆。",
          "en": "The painting later belonged to Caillebotte. After his death it entered the French national collection, hanging at the Musée du Luxembourg and then the Louvre, before moving to the Musée d'Orsay in 1986."
        }
      }
    ],
    "final": {
      "zh": "阳光、音乐和一个星期天的下午。",
      "en": "Sunlight, music and a Sunday afternoon."
    },
