  "cards": {
    "sunday": {
      "title": {
        "zh": "星期天下午",
        "en": "Sunday afternoon"
      },
      "text": {
        "zh": "星期天下午，巴黎人会打扮好来到这里，跳舞、喝酒、吃煎饼，一直玩到晚上。",
        "en": "On Sunday afternoons, Parisians dressed up and came here to dance, drink and eat galettes until evening."
      }
    },
    "galette": {
      "title": {
        "zh": "煎饼",
        "en": "The galette"
      },
      "text": {
        "zh": "“煎饼磨坊”的名字，来自这里的招牌点心：一种叫“galette”的煎饼。",
        "en": "The Moulin de la Galette took its name from its speciality, a kind of flat cake called a galette."
      }
    },
    "dapple": {
      "title": {
        "zh": "树下的光斑",
        "en": "Dappled light"
      },
      "text": {
        "zh": "阳光透过洋槐树的叶子，在人们的衣服和地上洒下一块块光斑。这是印象派很喜欢画的效果。",
        "en": "Sunlight filters through the acacia leaves, scattering patches of light on clothes and ground, an effect the Impressionists loved to paint."
      }
    },
    "stripes": {
      "title": {
        "zh": "条纹裙的女孩",
        "en": "The girl in stripes"
      },
      "text": {
        "zh": "前景中间穿条纹裙的女孩，据说是雷诺阿的模特让娜的姐姐埃丝特尔。",
        "en": "The girl in the striped dress in the centre foreground is said to be Estelle, the sister of Renoir's model Jeanne."
      }
    },
    "real": {
      "title": {
        "zh": "真实的人",
        "en": "Real people"
      },
      "text": {
        "zh": "和马奈画杜伊勒里花园一样，雷诺阿在画里放进了不少真实的人物肖像，有的是他的朋友。",
        "en": "As Manet had done in his painting of the Tuileries, Renoir included a number of real portraits, some of them his friends."
      }
    },
    "canvas": {
      "title": {
        "zh": "搬来搬去的画布",
        "en": "A canvas on the move"
      },
      "text": {
        "zh": "据他的朋友回忆，每到合适的时候，朋友们就帮雷诺阿把这张大画布从画室搬到舞场。",
        "en": "According to a friend, whenever the moment was right, Renoir's friends helped him carry this large canvas from his studio to the dance garden."
      }
    },
    "caillebotte": {
      "title": {
        "zh": "卡耶博特的画",
        "en": "Caillebotte's painting"
      },
      "text": {
        "zh": "1879年到1894年，这幅画属于画家卡耶博特。他去世后，它成为法国国家财产。",
        "en": "From 1879 to 1894, the painting belonged to the painter Caillebotte. After his death, it became the property of the French state."
      },
      "links": [
        {
          "scene": "paris-street-rainy-day",
          "href": "../paris-street-rainy-day/",
          "label": {
            "zh": "卡耶博特《巴黎街道，雨天》",
            "en": "Caillebotte's *Paris Street; Rainy Day*"
          }
        },
        {
          "scene": "gare-saint-lazare",
          "href": "../gare-saint-lazare/?card=caillebotte",
          "label": {
            "zh": "卡耶博特也收藏过《圣拉扎尔火车站》",
            "en": "Caillebotte also owned *The Saint-Lazare Station*"
          }
        }
      ]
    }
  },
  "exclusive": {
    "_说明": "独家发现“树间的光”：开关打开后，地上和人身上的光斑慢慢淡出；原画换成示意图（images/moulin-galette-even.jpg，是我们用原画做的示意：把树叶间漏下的亮斑压成周围的平均亮度，笔触保留），并显示说明。",
    "type": "toggles",
    "label": {
      "zh": "树间的光",
      "en": "Light through the leaves"
    },
    "toggles": [
      {
        "id": "shade",
        "label": {
          "zh": "树间的光",
          "en": "Light through the leaves"
        },
        "targets": [
          "dapples"
        ],
        "card": "dapple",
        "note": {
          "zh": "没有了树叶间漏下的光斑，这个下午就没有那么闪闪发亮了。这是示意。",
          "en": "Without the light filtering through the leaves, the afternoon loses its sparkle. This is an illustration."
        },
        "paintAlt": "images/moulin-galette-even.jpg"
      }
    ]
  },
  "ending": {
    "unlockAfter": 3,
    "acts": [
      {
        "image": "images/moulin-galette.jpg",
        "alt": {
          "zh": "雷诺阿《煎饼磨坊的舞会》1876，巴黎奥赛博物馆",
          "en": "Pierre-Auguste Renoir, Dance at Le Moulin de la Galette, 1876, Musée d'Orsay, Paris"
        },
        "caption": {
          "zh": "1876年 · 巴黎奥赛博物馆",
          "en": "1876 · Musée d'Orsay, Paris"
        },
        "kicker": "ACT I",
        "title": {
          "zh": "第一幕 · 蒙马特的星期天",
          "en": "A Sunday in Montmartre"
        },
        "text": {
          "zh": "19世纪70年代，蒙马特还像个乡村。山顶附近的煎饼磨坊，是附近居民和年轻人星期天下午跳舞的地方，也有不少画家来这里。",
          "en": "In the 1870s, Montmartre was still almost rural. The Moulin de la Galette, near the top of the hill, was where local people and young couples danced on Sunday afternoons, and where artists came too."
        }
      },
      {
        "image": "images/moulin-galette.jpg",
        "alt": {
          "zh": "雷诺阿《煎饼磨坊的舞会》1876，巴黎奥赛博物馆",
          "en": "Pierre-Auguste Renoir, Dance at Le Moulin de la Galette, 1876, Musée d'Orsay, Paris"
        },
        "caption": {
          "zh": "1876年 · 巴黎奥赛博物馆",
          "en": "1876 · Musée d'Orsay, Paris"
        },
        "kicker": "ACT II",
        "title": {
          "zh": "第二幕 · 在现场画",
          "en": "Painted on the spot"
        },
        "text": {
          "zh": "1876年，雷诺阿决定画下这里的舞会。他的朋友回忆，这幅画是完全在现场画的。不过雷诺阿还画了一幅较小的版本，到底哪一幅是在现场画的，至今仍有疑问。",
          "en": "In 1876, Renoir decided to paint the dancing here. A friend recalled that it was painted entirely on the spot. But Renoir also painted a smaller version, and which one was painted on site is still uncertain."
        }
      },
      {
        "image": "images/moulin-galette.jpg",
        "alt": {
          "zh": "雷诺阿《煎饼磨坊的舞会》1876，巴黎奥赛博物馆",
          "en": "Pierre-Auguste Renoir, Dance at Le Moulin de la Galette, 1876, Musée d'Orsay, Paris"
        },
        "caption": {
          "zh": "1876年 · 巴黎奥赛博物馆",
          "en": "1876 · Musée d'Orsay, Paris"
        },
        "kicker": "ACT III",
        "title": {
          "zh": "第三幕 · 从卡耶博特到奥赛",
          "en": "From Caillebotte to the Musée d'Orsay"
        },
        "text": {
          "zh": "这幅画后来属于卡耶博特。他去世后，它进入了法国国家收藏，先后挂在卢森堡博物馆和卢浮宫，1986年起在奥赛博物馆。",
          "en": "The painting later belonged to Caillebotte. After his death it entered the French national collection, hanging at the Musée du Luxembourg and then the Louvre, before moving to the Musée d'Orsay in 1986."
        }
      }
    ],
    "final": {
      "zh": "阳光、音乐和一个星期天的下午。",
      "en": "Sunlight, music and a Sunday afternoon."
    },
