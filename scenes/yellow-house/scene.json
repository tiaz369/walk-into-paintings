  "cards": {
    "shutters":   { "title": { "zh": "绿色百叶窗", "en": "Green shutters" },
                    "text": { "zh": "有绿色百叶窗的那一部分，就是梵高住的地方。1888年5月，他在这里租了四个房间。", "en": "The part with green shutters is where Van Gogh lived. In May 1888 he rented four rooms here." } },
    "restaurant": { "title": { "zh": "左边的餐馆", "en": "The restaurant" },
                    "text": { "zh": "梵高经常在画面左边的这家餐馆吃饭。", "en": "Van Gogh often ate at the restaurant on the left." } },
    "bridges":    { "title": { "zh": "铁路桥", "en": "Railway bridges" },
                    "text": { "zh": "他的朋友、邮递员约瑟夫·鲁兰，就住在第二座铁路桥后面。", "en": "His friend, the postman Joseph Roulin, lived just beyond the second railway bridge." } },
    "sky":        { "title": { "zh": "蓝天", "en": "The sky" },
                    "text": { "zh": "梵高在给提奥的信中写道，阳光下的黄房子，配上无比清新的蓝天，\"太了不起了\"。", "en": "Van Gogh wrote to Theo that the yellow houses in the sunlight, against the incomparably fresh blue, were \"tremendous\"." } },
    "ground":     { "title": { "zh": "黄色的地面", "en": "Yellow ground" },
                    "text": { "zh": "不只是房子，梵高说，连整个地面也是黄色的。", "en": "Not only the houses: Van Gogh said the whole ground was yellow too." } },
    "title":      { "title": { "zh": "画的名字", "en": "The title" },
                    "text": { "zh": "梵高自己把这幅画叫作《街道》，因为他画的不只是房子，而是他每天生活的这一片街区。", "en": "Van Gogh called this painting \"The Street\": it shows not just his house, but the neighbourhood he lived in every day." } }
  },

  "ending": {
    "unlockAfter": 3,
    "acts": [
      { "image": "images/yellow-house.jpg", "alt": { "zh": "梵高《黄房子（街道）》1888", "en": "Vincent van Gogh, The Yellow House (The Street), 1888" },
        "caption": { "zh": "1888年9月 · 阿姆斯特丹梵高博物馆", "en": "September 1888 · Van Gogh Museum, Amsterdam" },
        "kicker": "ACT I", "title": { "zh": "第一幕 · 搬进来", "en": "Moving in" },
        "text": { "zh": "1888年5月，梵高在阿尔勒拉马丁广场租下黄房子的四个房间。他终于有了一个地方，不仅能画画，还能请朋友来住。", "en": "In May 1888, Van Gogh rented four rooms in the Yellow House on Place Lamartine in Arles. At last he had a place to paint, and to invite friends to stay." } },
      { "kicker": "ACT II", "title": { "zh": "第二幕 · 画家之家", "en": "A house for artists" },
        "text": { "zh": "他想把这里变成一座画家之家，让志同道合的画家一起生活和创作。那年秋天，高更来了，在这里短暂住过一段时间。", "en": "He hoped to turn it into a house for artists, where like-minded painters could live and work together. That autumn, Gauguin came and stayed here for a short time." } },
      { "kicker": "ACT III", "title": { "zh": "第三幕 · 消失的房子", "en": "The house that disappeared" },
        "text": { "zh": "黄房子今天已经不在了。没有了房子的广场，看起来几乎和当年一样。", "en": "The Yellow House no longer exists. Without it, the square looks almost the same as it did then." } }
    ],
    "final": { "zh": "房子不在了，画还在。", "en": "The house is gone. The painting remains." },
