  "cards": {
    "chair": {
      "title": {
        "zh": "空椅子",
        "en": "The empty chair"
      },
      "text": {
        "zh": "埃莱娜站在父亲的书房里，双手搭在父亲那把空着的椅子背上。",
        "en": "Hélène stands in her father's study, her hands resting on the back of his empty chair."
      }
    },
    "egypt": {
      "title": {
        "zh": "埃及雕像",
        "en": "Egyptian statues"
      },
      "text": {
        "zh": "她身后的玻璃柜里，有三尊埃及雕像。她的父亲去过埃及，也收藏埃及文物。",
        "en": "Behind her, in a glass case, are three Egyptian statues. Her father had visited Egypt and collected Egyptian artefacts."
      }
    },
    "kylin": {
      "title": {
        "zh": "麒麟挂毯",
        "en": "The kylin hanging"
      },
      "text": {
        "zh": "她头顶上方，挂着一幅橙红色的中国丝绸挂毯，上面绣着金色的麒麟，一种看起来有点像狮子的神兽。",
        "en": "Above her hangs an orange-red Chinese silk hanging, decorated with golden kylins, mythical creatures that look a little like stylised lions."
      }
    },
    "collection": {
      "title": {
        "zh": "父亲的收藏",
        "en": "Her father's collection"
      },
      "text": {
        "zh": "墙上还有父亲收藏的画，包括一幅柯罗的画和一幅米勒的素描。",
        "en": "On the walls are other works from her father's collection, including a painting by Corot and a drawing by Millet."
      }
    },
    "ring": {
      "title": {
        "zh": "没画的戒指",
        "en": "No wedding ring"
      },
      "text": {
        "zh": "画这幅画时，埃莱娜23岁，已经结婚，但德加没有画出她的结婚戒指，也许是为了强调她作为女儿的身份。",
        "en": "Hélène was 23 and married when this was painted, but Degas does not show her wedding ring, perhaps to emphasise her status as a daughter."
      }
    },
    "layers": {
      "title": {
        "zh": "一层层的颜色",
        "en": "Layers of colour"
      },
      "text": {
        "zh": "仔细看，淡紫色的墙面下透出绿色和金色，蓝裙子的一些地方透出红色。",
        "en": "Look closely: greens and golds show through the lilac wall, and reds through parts of the blue dress."
      }
    },
    "nine": {
      "title": {
        "zh": "九岁时的她",
        "en": "At nine years old"
      },
      "text": {
        "zh": "埃莱娜九岁时，德加就画过她坐在父亲膝上的样子。",
        "en": "When Hélène was nine, Degas had painted her sitting on her father's knee."
      }
    }
  },
  "exclusive": {
    "_说明": "独家发现“这间房间在讲谁”（toggles）：开关打开后，属于父亲的东西（空椅子、书桌、埃及雕像、中国挂毯、墙上的画）外面一个接一个浮现淡黄色的框（reveal + stagger），埃莱娜保持原样；显示说明。框是示意，所以说明里写“这是示意”。",
    "type": "toggles",
    "toggles": [
      {
        "id": "father",
        "label": {
          "zh": "这间房间在讲谁",
          "en": "Whose room is this?"
        },
        "targets": [],
        "reveal": [
          "g-chair",
          "g-desk",
          "g-case",
          "g-hanging",
          "g-pictures"
        ],
        "stagger": 0.6,
        "duration": 4,
        "note": {
          "zh": "画名说的是她，房间讲的却是她的父亲。这是示意。",
          "en": "The title names her, but the room speaks of her father. This is an illustration."
        }
      }
    ]
  },
  "ending": {
    "unlockAfter": 3,
    "acts": [
      {
        "image": "images/helene-rouart.jpg",
        "alt": {
          "zh": "德加《埃莱娜·鲁阿尔在父亲的书房》约1886，伦敦国家美术馆",
          "en": "Edgar Degas, Hélène Rouart in her Father's Study, about 1886, The National Gallery, London"
        },
        "caption": {
          "zh": "约1886年 · 伦敦国家美术馆",
          "en": "about 1886 · The National Gallery, London"
        },
        "kicker": "ACT I",
        "title": {
          "zh": "第一幕 · 老朋友的女儿",
          "en": "An old friend's daughter"
        },
        "text": {
          "zh": "亨利·鲁阿尔是一位工程师，也画风景画，还和印象派画家一起参展。他是德加的老朋友，也是一位大收藏家。德加只给家人和熟悉的人画肖像。",
          "en": "Henri Rouart was an engineer who also painted landscapes and exhibited with the Impressionists. He was Degas's old friend, and a great collector. Degas only painted portraits of family and people he knew well."
        }
      },
      {
        "image": "images/helene-rouart.jpg",
        "alt": {
          "zh": "德加《埃莱娜·鲁阿尔在父亲的书房》约1886，伦敦国家美术馆",
          "en": "Edgar Degas, Hélène Rouart in her Father's Study, about 1886, The National Gallery, London"
        },
        "caption": {
          "zh": "约1886年 · 伦敦国家美术馆",
          "en": "about 1886 · The National Gallery, London"
        },
        "kicker": "ACT II",
        "title": {
          "zh": "第二幕 · 一间说着父亲的房间",
          "en": "A room that speaks of her father"
        },
        "text": {
          "zh": "画名说这是埃莱娜的肖像，可是仔细看，这间房间讲的几乎都是她的父亲：他的椅子、他的书桌、他从埃及和中国收集来的东西。",
          "en": "The title suggests a portrait of Hélène. But look closely, and the room tells us almost everything about her father: his chair, his desk, the things he collected from Egypt and China."
        }
      },
      {
        "image": "images/helene-rouart.jpg",
        "alt": {
          "zh": "德加《埃莱娜·鲁阿尔在父亲的书房》约1886，伦敦国家美术馆",
          "en": "Edgar Degas, Hélène Rouart in her Father's Study, about 1886, The National Gallery, London"
        },
        "caption": {
          "zh": "约1886年 · 伦敦国家美术馆",
          "en": "about 1886 · The National Gallery, London"
        },
        "kicker": "ACT III",
        "title": {
          "zh": "第三幕 · 来到伦敦",
          "en": "To London"
        },
        "text": {
          "zh": "1981年，伦敦国家美术馆买下了这幅画。今天，它挂在41号展厅。",
          "en": "In 1981, the National Gallery bought this painting. Today it hangs in Room 41."
        }
      }
    ],
    "final": {
      "zh": "她站在父亲的房间里。",
      "en": "She stands in her father's room."
    },
