  "cards": {
    "seine": {
      "title": {
        "zh": "塞纳河边",
        "en": "By the Seine"
      },
      "text": {
        "zh": "几个男人和男孩，在巴黎西北部的工业郊区阿涅尔的塞纳河岸边休息。",
        "en": "Several men and boys relax on the banks of the Seine at Asnières, an industrial suburb north-west of Paris."
      }
    },
    "sculpture": {
      "title": {
        "zh": "像雕塑一样",
        "en": "Like sculptures"
      },
      "text": {
        "zh": "他们都是侧面，像雕塑一样一动不动。修拉在美术学院学过临摹古典雕塑，几个人的姿势就反映了这一点。",
        "en": "Shown in profile, they are as still as sculptures. Seurat had learned to draw from classical sculpture at art school, and several of the poses reflect this."
      }
    },
    "thought": {
      "title": {
        "zh": "各自的思绪",
        "en": "Lost in thought"
      },
      "text": {
        "zh": "他们各自沉浸在自己的思绪里，既不互相交流，也不看向我们。",
        "en": "Each seems absorbed in his own thoughts, engaging neither with one another nor with us."
      }
    },
    "chimneys": {
      "title": {
        "zh": "远处的烟囱",
        "en": "The chimneys"
      },
      "text": {
        "zh": "远处是克利希的煤气厂和工厂的烟囱。画中有些人，可能就在那里工作。",
        "en": "In the distance are the chimneys of the gas plant and factories at Clichy, where some of these men may have worked."
      }
    },
    "bridges": {
      "title": {
        "zh": "两座桥",
        "en": "Two bridges"
      },
      "text": {
        "zh": "背景里，一座铁路桥挡住了另一座平行的公路桥。",
        "en": "In the background, a railway bridge partly hides a parallel road bridge."
      }
    },
    "dots": {
      "title": {
        "zh": "后来加的小点",
        "en": "Dots added later"
      },
      "text": {
        "zh": "大约1886年，修拉发明了用对比色小点作画的技法，之后又回来修改了这幅画，比如右边男孩的帽子。",
        "en": "Around 1886, after inventing his technique of dots of contrasting colour, Seurat returned to this painting and reworked parts of it, such as the hat of the boy on the right."
      }
    }
  },
