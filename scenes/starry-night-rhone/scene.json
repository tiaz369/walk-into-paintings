  "cards": {
    "blues": {
      "title": {
        "zh": "三种蓝",
        "en": "Three blues"
      },
      "text": {
        "zh": "画夜晚，他不用黑色，而是用了普鲁士蓝、群青和钴蓝。",
        "en": "To paint the night, he used not black but Prussian blue, ultramarine and cobalt."
      }
    },
    "lights": {
      "title": {
        "zh": "水中的灯光",
        "en": "Lights on the water"
      },
      "text": {
        "zh": "城里的煤气灯是强烈的橙色，倒映在罗纳河的水面上。",
        "en": "The city's gaslights glow an intense orange, reflected in the Rhône."
      }
    },
    "stars": {
      "title": {
        "zh": "星星",
        "en": "The stars"
      },
      "text": {
        "zh": "星星像宝石一样闪烁。",
        "en": "The stars sparkle like gemstones."
      }
    },
    "lovers": {
      "title": {
        "zh": "河边的恋人",
        "en": "The lovers"
      },
      "text": {
        "zh": "画面下方有一对散步的恋人，让这片星夜显得安静而温柔。",
        "en": "A couple strolls at the bottom of the painting, making this starry night calm and tender."
      }
    },
    "longwish": {
      "title": {
        "zh": "念念不忘",
        "en": "A long wish"
      },
      "text": {
        "zh": "早在1888年4月，他就写信说：\"我需要一个星夜。\"",
        "en": "As early as April 1888, he wrote: \"I need a starry night.\""
      },
      "link": {
        "scene": "cafe-terrace",
        "href": "../cafe-terrace/",
        "label": {
          "zh": "去看《夜晚露天咖啡座》",
          "en": "See Café Terrace at Night"
        }
      }
    },
    "atnight": {
      "title": {
        "zh": "在夜里画",
        "en": "Painted at night"
      },
      "text": {
        "zh": "他告诉提奥，终于画出了星空，而且真的是在夜里、在煤气灯下画的。",
        "en": "He told Theo he had painted the starry sky at last, actually at night, under a gas lamp."
      }
    }
  },
  "ending": {
    "unlockAfter": 3,
    "acts": [
      {
        "image": "images/starry-night-rhone.jpg",
        "alt": {
          "zh": "梵高《罗纳河上的星夜》1888",
          "en": "Vincent van Gogh, Starry Night over the Rhône, 1888"
        },
        "caption": {
          "zh": "1888年9月 · 巴黎奥赛博物馆",
          "en": "September 1888 · Musée d'Orsay, Paris"
        },
        "kicker": "ACT I",
        "title": {
          "zh": "第一幕 · 念念不忘",
          "en": "A long wish"
        },
        "text": {
          "zh": "1888年2月来到阿尔勒后，梵高一直想画夜晚。4月，他写信说需要一个星夜；6月，他又说这幅画一直萦绕在心头。",
          "en": "After arriving in Arles in February 1888, Van Gogh kept thinking about painting the night. In April he wrote that he needed a starry night; in June, that the painting kept haunting him."
        }
      },
      {
        "kicker": "ACT II",
        "title": {
          "zh": "第二幕 · 终于画出星空",
          "en": "At last, the starry sky"
        },
        "text": {
          "zh": "他先在《夜晚露天咖啡座》里画了一角夜空。九月底，他来到罗纳河边，画下了整片星空。",
          "en": "He first painted a corner of night sky in Café Terrace at Night. At the end of September, by the Rhône, he painted the whole starry sky."
        },
        "more": {
          "scene": "cafe-terrace",
          "href": "../cafe-terrace/",
          "label": {
            "zh": "去看《夜晚露天咖啡座》",
            "en": "See Café Terrace at Night"
          }
        }
      },
      {
        "image": "images/starry-night-1889.jpg",
        "alt": {
          "zh": "梵高《星夜》1889",
          "en": "Vincent van Gogh, The Starry Night, 1889"
        },
        "caption": {
          "zh": "1889 · 纽约现代艺术博物馆",
          "en": "1889 · MoMA, New York"
        },
        "credit": {
          "zh": "《星夜》图片：Wikimedia Commons（Google Art Project），公有领域",
          "en": "The Starry Night image: Wikimedia Commons (Google Art Project), public domain"
        },
        "kicker": "ACT III",
        "title": {
          "zh": "第三幕 · 另一个星夜",
          "en": "Another Starry Night"
        },
        "text": {
          "zh": "几个月后，他住进圣雷米的疗养院，又画了一幅《星夜》，现藏纽约现代艺术博物馆。那一幅翻涌不安，这一幅却安静温柔。",
          "en": "A few months later, in the asylum at Saint-Rémy, he painted another Starry Night, now at MoMA in New York. That one is turbulent; this one is calm."
        }
      }
    ],
    "final": {
      "zh": "他终于画出了星空。",
      "en": "At last, he painted the starry sky."
    },
