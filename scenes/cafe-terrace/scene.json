  "cards": {
    "awning": {
      "title": {
        "zh": "黄色雨棚",
        "en": "The awning"
      },
      "text": {
        "zh": "梵高说，煤气灯的光是黄色和橙色的，会让蓝色显得更强烈。",
        "en": "Van Gogh said gaslight, being yellow and orange, makes blue more intense."
      }
    },
    "stars": {
      "title": {
        "zh": "星空",
        "en": "The stars"
      },
      "text": {
        "zh": "后来的天文研究发现，他画的星座位置，和1888年9月16日或17日夜里的星空一致。",
        "en": "Later astronomical research found that he painted the stars as they appeared on the night of 16 or 17 September 1888."
      }
    },
    "blueHouses": {
      "title": {
        "zh": "深蓝的房子",
        "en": "Blue houses"
      },
      "text": {
        "zh": "背景里深蓝色的房子，让雨棚下的暖黄色和夜空的深蓝对比更强烈。",
        "en": "The dark blue houses in the background strengthen the contrast between the warm yellow and the deep blue sky."
      }
    },
    "shop": {
      "title": {
        "zh": "右边的小店",
        "en": "The shop on the right"
      },
      "text": {
        "zh": "他画了右边一家亮着灯的小店和几根树枝，却省略了旁边的罗马遗迹。",
        "en": "He painted a lit shop and some tree branches on the right, but left out the Roman ruins beside it."
      }
    },
    "familiar": {
      "letter": { "_说明": "读原信：填 vangoghletters.org 上对应这封信的网址；空着时不显示。", "url": "" },
      "title": {
        "zh": "常去的咖啡馆",
        "en": "A familiar café"
      },
      "text": {
        "zh": "他写信给画家朋友欧仁·博赫，说画的是论坛广场上\"我们常去\"的那家咖啡馆。博赫的画像，就挂在梵高卧室的墙上。",
        "en": "He wrote to his painter friend Eugène Boch that this was the café on Place du Forum \"where we used to go\". Boch's portrait hangs on the wall of Van Gogh's bedroom."
      },
      "link": {
        "href": "../bedroom/",
        "label": {
          "zh": "去卧室看博赫的画像",
          "en": "See Boch's portrait in the bedroom"
        }
      }
    },
    "onspot": {
      "title": {
        "zh": "现场作画",
        "en": "Painted on the spot"
      },
      "text": {
        "zh": "他是在夜里、在黑暗中现场画的，因为颜色在白天和晚上看起来不一样。",
        "en": "He painted it on the spot, in the dark, because colours look different at night than by day."
      }
    }
  },
  "ending": {
    "unlockAfter": 3,
    "acts": [
      {
        "image": "images/cafe-terrace.jpg",
        "alt": {
          "zh": "梵高《夜晚露天咖啡座》1888",
          "en": "Vincent van Gogh, Terrace of a Café at Night, 1888"
        },
        "caption": {
          "zh": "约1888年9月16日 · 克勒勒-米勒博物馆",
          "en": "c. 16 September 1888 · Kröller-Müller Museum, Otterlo"
        },
        "kicker": "ACT I",
        "title": {
          "zh": "第一幕 · 没有黑色的夜",
          "en": "A night without black"
        },
        "text": {
          "zh": "梵高一直想画一幅夜景，但不想用传统的黑色和灰色，而是用丰富的颜色。",
          "en": "Van Gogh had long wanted to paint a night scene, not in black and grey, but full of colour."
        }
      },
      {
        "kicker": "ACT II",
        "title": {
          "zh": "第二幕 · 在黑暗中画",
          "en": "Painting in the dark"
        },
        "text": {
          "zh": "他在夜里来到论坛广场，在煤气灯下现场作画。他写信告诉妹妹威尔，他非常享受在夜里现场画画。",
          "en": "He went to Place du Forum at night and painted by gaslight. He wrote to his sister Wil that he enormously enjoyed painting on the spot at night."
        }
      },
      {
        "kicker": "ACT III",
        "title": {
          "zh": "第三幕 · 今天的广场",
          "en": "The square today"
        },
        "text": {
          "zh": "今天，你可以站在广场东北角，也就是他当年支画架的地方。这家咖啡馆在1990至1991年按画中的样子重新翻修过。",
          "en": "Today you can stand at the north-east corner of the square, where he set up his easel. The café was refurbished in 1990–91 to look like the painting."
        }
      }
    ],
    "final": {
      "zh": "夜，原来可以有这么多颜色。",
      "en": "The night has so many colours."
    },
