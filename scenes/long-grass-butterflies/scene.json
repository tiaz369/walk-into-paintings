  "cards": {
    "garden": {
      "title": {
        "zh": "疗养院的花园",
        "en": "The asylum garden"
      },
      "text": {
        "zh": "这是圣雷米圣保罗疗养院花园里的一片草地。梵高在这里住了一年。",
        "en": "This is a patch of meadow in the garden of the Saint-Paul asylum at Saint-Rémy, where Van Gogh stayed for a year."
      }
    },
    "butterflies": {
      "title": {
        "zh": "三只蝴蝶",
        "en": "Three butterflies"
      },
      "text": {
        "zh": "草间藏着三只蝴蝶，不太容易一眼看到。找到它们之后，整幅画就动了起来。",
        "en": "Three butterflies are hidden in the grass, not easy to spot at first. Once you find them, the whole painting comes alive."
      }
    },
    "grass": {
      "title": {
        "zh": "春天的草",
        "en": "Spring grass"
      },
      "text": {
        "zh": "画面几乎全是长长的、茂盛的春草，只有一角隐约露出一条小路。",
        "en": "The picture is filled almost entirely with long, lush spring grass; only a trace of a path appears in one corner."
      }
    },
    "closeup": {
      "title": {
        "zh": "近看自然",
        "en": "Nature up close"
      },
      "text": {
        "zh": "这种近距离画一小片自然的方式，在文艺复兴和17世纪荷兰绘画里都有先例；梵高也可能受到了他读到的日本文化的影响。",
        "en": "Painting a small patch of nature up close had precedents in Renaissance and 17th-century Dutch art; Van Gogh may also have been inspired by what he read about Japanese culture."
      }
    },
    "leaving": {
      "title": {
        "zh": "离开之前",
        "en": "Before leaving"
      },
      "text": {
        "zh": "这是梵高在圣雷米画的最后几幅画之一。两周后，他就离开了疗养院。",
        "en": "This is one of the last paintings Van Gogh made at Saint-Rémy. Two weeks later, he left the asylum."
      }
    },
    "irises": {
      "title": {
        "zh": "同一个花园",
        "en": "The same garden"
      },
      "text": {
        "zh": "一年前，他刚来到这里，就在同一个花园里画了《鸢尾花》。",
        "en": "A year earlier, just after he arrived, he had painted *Irises* in this same garden."
      },
      "links": [
        {
          "scene": "irises",
          "href": "../irises/",
          "label": {
            "zh": "一年前，同一个花园",
            "en": "A year earlier, the same garden"
          }
        }
      ]
    }
  },
