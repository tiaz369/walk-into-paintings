  "cards": {
    "behind": {
      "title": {
        "zh": "幕后",
        "en": "Behind the scenes"
      },
      "text": {
        "zh": "德加喜欢捕捉幕后的瞬间。这里，四位芭蕾舞者正在侧幕休息。",
        "en": "Degas loved capturing moments behind the scenes. Here, four ballet dancers rest in the wings."
      }
    },
    "crouch": {
      "title": {
        "zh": "蹲下的舞者",
        "en": "Crouching down"
      },
      "text": {
        "zh": "第一位舞者蹲着，也许在揉酸痛的肌肉，也许在整理丝带。",
        "en": "The first dancer crouches down, perhaps to ease a sore muscle or adjust a ribbon."
      }
    },
    "tired": {
      "title": {
        "zh": "累了",
        "en": "Exhausted"
      },
      "text": {
        "zh": "她身后的舞者明显累坏了，一手托着头。",
        "en": "The dancer behind her is visibly exhausted, resting her head in one hand."
      }
    },
    "fan": {
      "title": {
        "zh": "扇子",
        "en": "The fan"
      },
      "text": {
        "zh": "第三位舞者拿着一把色彩鲜艳的扇子。",
        "en": "The third dancer holds a brightly coloured fan."
      }
    },
    "wall": {
      "title": {
        "zh": "靠在墙上",
        "en": "Against the wall"
      },
      "text": {
        "zh": "第四位舞者靠在墙上。",
        "en": "The fourth leans against the wall."
      }
    },
    "diagonal": {
      "title": {
        "zh": "一条斜线",
        "en": "A diagonal"
      },
      "text": {
        "zh": "四位舞者沿着一条斜线排列，构图不对称，右下角被截断，这是受了日本版画的影响。",
        "en": "The four dancers are arranged along a diagonal, in an asymmetrical composition cropped at the lower right, reflecting the influence of Japanese prints."
      },
      "link": {
        "scene": "bedroom",
        "href": "../bedroom/?card=floor",
        "label": {
          "zh": "梵高也受日本版画影响",
          "en": "Van Gogh was influenced by Japanese prints too"
        }
      }
    },
    "pastel": {
      "title": {
        "zh": "粉彩",
        "en": "Pastel"
      },
      "text": {
        "zh": "这幅画用的是粉彩。德加从19世纪80年代起特别喜欢粉彩，因为它能画出非常鲜艳的颜色。",
        "en": "This is a pastel. From the 1880s, Degas favoured pastel for its vivid colours."
      }
    }
  },
  "exclusive": {
    "_说明": "独家发现“拼起来的瞬间”：开关打开后，四位舞者淡出，后面浮现四张单独的“习作纸”（每张是原画里一位舞者的裁剪（study-1 蹲着的，study-2 托着头的，study-3 拿扇子的，study-4 靠墙的），放在纸色背景上，是我们做的示意，不是德加的习作）；再关上，她们又回到同一个画面里。显示说明。",
    "type": "toggles",
    "label": {
      "zh": "拼起来的瞬间",
      "en": "A moment pieced together"
    },
    "toggles": [
      {
        "id": "studies",
        "label": {
          "zh": "拼起来的瞬间",
          "en": "A moment pieced together"
        },
        "targets": [
          "d1",
          "d2",
          "d3",
          "d4"
        ],
        "reveal": [
          "study1",
          "study2",
          "study3",
          "study4"
        ],
        "card": "pastel",
        "note": {
          "zh": "这个看起来像快照的瞬间，其实是德加在画室里，用几张单人习作拼起来的。这是示意。",
          "en": "This moment, which looks like a snapshot, was in fact put together in the studio from separate studies. This is an illustration."
        }
      }
    ]
  },
