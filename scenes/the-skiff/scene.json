  "ending": {
    "unlockAfter": 3,
    "acts": [
      {
        "image": "images/the-skiff.jpg",
        "alt": {
          "zh": "雷诺阿《小船》1875，伦敦国家美术馆",
          "en": "Pierre-Auguste Renoir, The Skiff (La Yole), 1875, The National Gallery, London"
        },
        "caption": {
          "zh": "1875年 · 伦敦国家美术馆",
          "en": "1875 · The National Gallery, London"
        },
        "kicker": "ACT I",
        "title": {
          "zh": "第一幕 · 塞纳河上的夏天",
          "en": "Summer on the Seine"
        },
        "text": {
          "zh": "19世纪70年代，雷诺阿画了好几幅塞纳河上的划船场景。这一幅很可能画的是巴黎西边的沙图，但具体是哪里，至今还没有确定。",
          "en": "In the 1870s, Renoir painted several boating scenes on the Seine. This one probably shows the river at Chatou, west of Paris, though the exact spot has never been identified."
        }
      },
      {
        "image": "images/the-skiff.jpg",
        "alt": {
          "zh": "雷诺阿《小船》1875，伦敦国家美术馆",
          "en": "Pierre-Auguste Renoir, The Skiff (La Yole), 1875, The National Gallery, London"
        },
        "caption": {
          "zh": "1875年 · 伦敦国家美术馆",
          "en": "1875 · The National Gallery, London"
        },
        "kicker": "ACT II",
        "title": {
          "zh": "第二幕 · 科学和颜色",
          "en": "Science and colour"
        },
        "text": {
          "zh": "19世纪的科学发现，深刻影响了画家。雷诺阿在这里大胆地把互补色放在一起：橙色的小船，蓝色的河。",
          "en": "The scientific discoveries of the 19th century had a deep influence on painters. Here Renoir boldly places complementary colours side by side: an orange boat on a blue river."
        }
      },
      {
        "image": "images/the-skiff.jpg",
        "alt": {
          "zh": "雷诺阿《小船》1875，伦敦国家美术馆",
          "en": "Pierre-Auguste Renoir, The Skiff (La Yole), 1875, The National Gallery, London"
        },
        "caption": {
          "zh": "1875年 · 伦敦国家美术馆",
          "en": "1875 · The National Gallery, London"
        },
        "kicker": "ACT III",
        "title": {
          "zh": "第三幕 · 来到伦敦",
          "en": "To London"
        },
        "text": {
          "zh": "1982年，伦敦国家美术馆买下了这幅画。",
          "en": "In 1982, the National Gallery in London bought this painting."
        }
      }
    ],
