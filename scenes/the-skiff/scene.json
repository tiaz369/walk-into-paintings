  "cards": {
    "orange": {
      "title": {
        "zh": "橙色和蓝色",
        "en": "Orange and blue"
      },
      "text": {
        "zh": "雷诺阿把鲜橙色的小船，放在深蓝色的河水上。这两种颜色放在一起，彼此都会显得更强烈。",
        "en": "Renoir placed the bright orange boat against the deep blue water. Side by side, each colour looks more intense."
      }
    },
    "complementary": {
      "title": {
        "zh": "互补色",
        "en": "Complementary colours"
      },
      "text": {
        "zh": "法国化学家谢弗勒尔在1839年提出，蓝色和橙色是互补色。19世纪的新科学，鼓励印象派画家去尝试这样的颜色组合。",
        "en": "In 1839, the French chemist Michel-Eugène Chevreul showed that blue and orange are complementary colours. New science like this encouraged the Impressionists to experiment."
      }
    },
    "women": {
      "title": {
        "zh": "两位女子",
        "en": "Two women"
      },
      "text": {
        "zh": "小船上坐着两位穿着时髦的女子，一位划着船。",
        "en": "Two fashionably dressed women sit in the skiff; one of them is rowing."
      }
    },
    "sailboat": {
      "title": {
        "zh": "帆船",
        "en": "The sailboat"
      },
      "text": {
        "zh": "右边那条帆船的白帆，平衡了整个画面；它的船身颜色，也和小船呼应。",
        "en": "The white sail of the sailboat on the right balances the picture, and its hull echoes the colour of the skiff."
      }
    },
    "train": {
      "title": {
        "zh": "远处的火车",
        "en": "The train"
      },
      "text": {
        "zh": "远处有一列冒着烟的蒸汽火车开过。这是印象派画家很喜欢放进画里的现代生活。",
        "en": "In the distance, a steam train passes, a touch of modern life the Impressionists loved to include."
      }
    },
    "colours": {
      "title": {
        "zh": "船的颜色",
        "en": "The boat's colours"
      },
      "text": {
        "zh": "国家美术馆的研究发现，船身用的是铬黄和柠檬黄，船的轮廓用的是铬橙。",
        "en": "Research at the National Gallery found that the boat is painted in chrome yellow and lemon yellow, outlined in chrome orange."
      }
    }
  },
