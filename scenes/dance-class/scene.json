  "cards": {
    "master": {
      "title": {
        "zh": "芭蕾大师",
        "en": "The ballet master"
      },
      "text": {
        "zh": "主持这堂课的是著名的芭蕾大师于勒·佩罗。1874年他已经64岁，退休后经常在歌剧院教课。",
        "en": "The class is led by the famous ballet master Jules Perrot. In 1874 he was 64, a retired master who often taught classes at the Opéra."
      }
    },
    "cane": {
      "title": {
        "zh": "手杖",
        "en": "The cane"
      },
      "text": {
        "zh": "佩罗站在画面右边，看起来却像在房间中央。他双臂伸开，双手扶着一根长手杖。",
        "en": "Perrot stands at the right of the picture, yet seems to be at the centre of the room, arms outstretched, hands resting on a long cane."
      }
    },
    "exam": {
      "title": {
        "zh": "考试",
        "en": "The examination"
      },
      "text": {
        "zh": "中间一位舞者正在做“阿提丢”（attitude）舞姿，接受考试。",
        "en": "In the middle, a dancer performs an \"attitude\" for her examination."
      }
    },
    "waiting": {
      "title": {
        "zh": "等待的人",
        "en": "Those who wait"
      },
      "text": {
        "zh": "画中大约有24位女性，是芭蕾舞者和她们的母亲，都在等待。",
        "en": "Some 24 women, dancers and their mothers, are waiting."
      }
    },
    "poster": {
      "title": {
        "zh": "墙上的海报",
        "en": "The poster"
      },
      "text": {
        "zh": "镜子旁边贴着罗西尼歌剧《威廉·退尔》的海报，是向委托这幅画的歌唱家福尔致敬。",
        "en": "Beside the mirror is a poster for Rossini's opera *William Tell*, a tribute to the singer Faure, who commissioned the picture."
      }
    },
    "opera": {
      "title": {
        "zh": "已经不在的歌剧院",
        "en": "An opera house now gone"
      },
      "text": {
        "zh": "这间排练室在旧巴黎歌剧院里，而那座歌剧院不久前刚被烧毁。这是一个想象的场景。",
        "en": "This rehearsal room is in the old Paris Opéra, which had recently burned down. The scene is imagined."
      }
    }
  },
