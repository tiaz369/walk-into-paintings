  "cards": {
    "rider": {
      "title": {
        "zh": "女骑手",
        "en": "The rider"
      },
      "text": {
        "zh": "一位女骑手站在奔跑的白马背上，保持着平衡。",
        "en": "A female rider keeps her balance on the back of a galloping white horse."
      }
    },
    "ringmaster": {
      "title": {
        "zh": "领班",
        "en": "The ringmaster"
      },
      "text": {
        "zh": "领班挥着鞭子，指挥着整场表演。",
        "en": "The ringmaster cracks his whip, directing the performance."
      }
    },
    "clown": {
      "title": {
        "zh": "小丑",
        "en": "The clown"
      },
      "text": {
        "zh": "前景的小丑背对着我们，红色的头发和衣服特别醒目。",
        "en": "In the foreground, a clown with striking red hair and costume stands with his back to us."
      }
    },
    "rising": {
      "title": {
        "zh": "上升的线",
        "en": "Rising lines"
      },
      "text": {
        "zh": "当时的评论家注意到，画里到处是上升的线条，加上占主导的橙色，营造出一种欢乐感。",
        "en": "A critic of the time noted the ascending lines everywhere and the dominant orange, creating a sense of gaiety."
      }
    },
    "rows": {
      "title": {
        "zh": "一排排观众",
        "en": "Rows of spectators"
      },
      "text": {
        "zh": "看台上的观众被简化成一排排，几乎变成了图案。",
        "en": "The spectators in the stands are simplified into rows, almost a pattern."
      }
    },
    "unfinished": {
      "title": {
        "zh": "没画完的地方",
        "en": "Unfinished"
      },
      "text": {
        "zh": "这幅画没有画完。有些地方还能看到白色的底子和蓝色的构图格线。",
        "en": "The painting was never finished. In places you can still see the white ground and the blue grid of the composition."
      }
    },
    "frame": {
      "title": {
        "zh": "画出来的框",
        "en": "A painted frame"
      },
      "text": {
        "zh": "修拉在画布边缘画了一圈深色边框，又配了一个同样深蓝色的平面画框，让画框也成为作品的一部分。",
        "en": "Seurat painted a dark border on the edge of the canvas, and added a flat frame in the same blue, making the frame part of the work."
      }
    }
  },
  "exclusive": {
    "_说明": "独家发现“没画完的地方”：站到画家视角点时，画面放大到原画上还能看到白色底子和蓝色格线的地方，显示卡片6的文字。只是放大原画，不是示意效果，所以不显示“这是示意”。crop 是那一块在原画上的位置（0–1：x、y 是左上角，w、h 是宽高），照着 images/circus.jpg 选的右上方入口和帘子一带：点很稀，露出浅色的底子和蓝色的线（Claude 按画面选的位置，等 Tia 核对）。",
    "type": "mirror",
    "label": {
      "zh": "没画完的地方",
      "en": "The unfinished parts"
    },
