  "cards": {
    "wheat": {
      "title": {
        "zh": "金色麦田",
        "en": "The wheat field"
      },
      "text": {
        "zh": "金色的麦田，是普罗旺斯夏天最典型的景色。",
        "en": "The golden wheat field is a classic sight of a Provençal summer."
      }
    },
    "cypress": {
      "title": {
        "zh": "柏树",
        "en": "The cypresses"
      },
      "text": {
        "zh": "1889年6月底，他决定把在圣雷米最早的一组画，献给这些高耸的柏树。",
        "en": "In late June 1889, he decided to devote one of his first series at Saint-Rémy to these towering trees."
      }
    },
    "olive": {
      "title": {
        "zh": "橄榄树丛",
        "en": "The olive bush"
      },
      "text": {
        "zh": "麦田旁边是一丛橄榄树，同样是普罗旺斯的典型景物。",
        "en": "Beside the wheat is an olive bush, another typical sight of Provence."
      }
    },
    "mountains": {
      "title": {
        "zh": "蓝色的山",
        "en": "The blue mountains"
      },
      "text": {
        "zh": "远处蓝色的山，是阿尔皮耶山。",
        "en": "The blue mountains in the distance are the Alpilles."
      }
    },
    "mistral": {
      "title": {
        "zh": "风",
        "en": "The mistral"
      },
      "text": {
        "zh": "他写到自己在夏天的密史脱拉风里户外作画。这股又强又冷的风，让整片风景都动了起来。",
        "en": "He wrote of painting outdoors in the summer mistral, the strong, cold wind of southern France, which seems to set the whole landscape in motion."
      }
    },
    "mother": {
      "title": {
        "zh": "给母亲和妹妹",
        "en": "For his mother and sister"
      },
      "text": {
        "zh": "他还为母亲和妹妹画了一幅小一点的复本，就像他对卧室做过的那样。",
        "en": "He also made a smaller copy for his mother and sister, just as he did with The Bedroom."
      },
      "link": {
        "scene": "bedroom",
        "href": "../bedroom/",
        "label": {
          "zh": "去看《阿尔勒的卧室》",
          "en": "See The Bedroom"
        }
      }
    }
  },
  "ending": {
    "unlockAfter": 3,
    "acts": [
      {
        "image": "images/wheatfield-met.jpg",
        "alt": {
          "zh": "梵高《麦田与柏树》现场习作，1889年6月",
          "en": "Vincent van Gogh, Wheat Field with Cypresses, study, June 1889"
        },
        "caption": {
          "zh": "现场习作 · 1889年6月 · 纽约大都会博物馆",
          "en": "Study painted on the spot · June 1889 · The Metropolitan Museum of Art, New York"
        },
        "credit": {
          "zh": "图片：大都会博物馆开放资源（CC0）",
          "en": "Image: The Met Open Access (CC0)"
        },
        "kicker": "ACT I",
        "title": {
          "zh": "第一幕 · 在现场",
          "en": "On the spot"
        },
        "text": {
          "zh": "1889年5月，梵高自愿住进圣雷米的圣保罗疗养院。6月底，他走到户外，在麦田边画下了第一幅习作。它现在在纽约大都会博物馆。",
          "en": "In May 1889, Van Gogh voluntarily entered the asylum of Saint-Paul de Mausole in Saint-Rémy. In late June, he went outdoors and painted a first study by the wheat field. It is now at the Metropolitan Museum in New York."
        }
      },
      {
        "image": "images/wheatfield-cypresses.jpg",
        "alt": {
          "zh": "梵高《麦田与柏树》1889年9月",
          "en": "Vincent van Gogh, A Wheatfield, with Cypresses, September 1889"
        },
        "caption": {
          "zh": "定稿 · 1889年9月 · 伦敦国家美术馆",
          "en": "Finished version · September 1889 · The National Gallery, London"
        },
        "kicker": "ACT II",
        "title": {
          "zh": "第二幕 · 在房间里",
          "en": "In his room"
        },
        "text": {
          "zh": "九月，他被限制在病房里，凭着那幅习作，画出了这幅定稿。",
          "en": "In September, confined to his room, he painted this finished version from that study."
        }
      },
      {
        "kicker": "ACT III",
        "title": {
          "zh": "第三幕 · 来到伦敦",
          "en": "To London"
        },
        "text": {
          "zh": "1923年，伦敦国家美术馆用考陶尔德基金买下了这幅画。今天，它就挂在43号展厅。",
          "en": "In 1923, the National Gallery in London bought the painting with the Courtauld Fund. Today it hangs in Room 43."
        }
      }
    ],
    "final": {
      "zh": "除了凝望麦田，还能做什么呢。",
      "en": "What else can one do… but gaze upon the wheatfields."
    },
    "finalBy": {
      "zh": "—— 梵高致妹妹，1889年7月2日",
      "en": "— Van Gogh to his sister, 2 July 1889"
    },
    "versions": [
      {
