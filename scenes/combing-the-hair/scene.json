  "cards": {
    "combing": {
      "title": {
        "zh": "梳头",
        "en": "Combing the hair"
      },
      "text": {
        "zh": "女仆左手托起女主人又长又重的红发，右手把梳子拉过头发中段。",
        "en": "With her left hand the maid lifts the long, heavy red hair of her mistress; with her right she pulls a comb through it."
      }
    },
    "raised": {
      "title": {
        "zh": "抬起的手",
        "en": "A raised hand"
      },
      "text": {
        "zh": "被梳头的力道往后拉，女主人抬起右手按住头，好像是为了稳住自己，或者按住头发。",
        "en": "Pulled back by the force of the strokes, the mistress raises her right hand to her head, as if to steady herself or hold her hair in place."
      }
    },
    "diagonal": {
      "title": {
        "zh": "一条斜线",
        "en": "A diagonal"
      },
      "text": {
        "zh": "从女仆的头和手臂，沿着女主人斜靠的身体，形成一条有力的斜线。",
        "en": "A powerful diagonal runs from the maid's head and arm down the length of her mistress's reclining body."
      }
    },
    "red": {
      "title": {
        "zh": "满屏的红",
        "en": "All that red"
      },
      "text": {
        "zh": "裙子、头发、墙，几乎全是红色和橙色。德加晚年的颜色越来越大胆，轮廓线也越来越粗黑。",
        "en": "Dress, hair, walls: almost everything is red or orange. In his last years, Degas's colours grew bolder and his outlines thicker and darker."
      }
    },
    "reds": {
      "title": {
        "zh": "不同的红",
        "en": "Different reds"
      },
      "text": {
        "zh": "国家美术馆的研究发现，裙子用的是朱砂，墙用的是铅丹，再加一点点绿色。",
        "en": "Research at the National Gallery found that the dress is painted in vermilion, and the wall in red lead with a little green added."
      }
    },
    "matisse": {
      "title": {
        "zh": "马蒂斯的画",
        "en": "Matisse's painting"
      },
      "text": {
        "zh": "德加去世后，画家马蒂斯买下了这幅画。马蒂斯后来也以大胆的红色著称。",
        "en": "After Degas's death, the painter Henri Matisse bought this picture. Matisse, too, became known for his bold use of red."
      }
    }
  },
