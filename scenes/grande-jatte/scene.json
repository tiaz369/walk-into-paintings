  "cards": {
    "island": {
      "title": {
        "zh": "塞纳河上的小岛",
        "en": "An island in the Seine"
      },
      "text": {
        "zh": "大碗岛是巴黎西边塞纳河上的一个小岛。星期天下午，不同阶层的人都来这里散步、休息。",
        "en": "La Grande Jatte is an island in the Seine, just west of Paris. On Sunday afternoons, people from different social classes came here to stroll and relax."
      }
    },
    "sculpture": {
      "title": {
        "zh": "像雕塑一样",
        "en": "Like ancient sculpture"
      },
      "text": {
        "zh": "画的是现代生活，修拉却想让它像古代埃及和希腊的雕塑一样，有一种永恒感。",
        "en": "Though the subject is modern life, Seurat wanted it to feel timeless, like ancient Egyptian and Greek sculpture."
      }
    },
    "dots": {
      "title": {
        "zh": "小点",
        "en": "Dots of colour"
      },
      "text": {
        "zh": "画面是由无数靠得很近的纯色小点组成的。从远处看，这些点会在眼睛里混合起来。",
        "en": "The picture is made of countless closely placed points of pure colour, which mix together in the viewer's eye from a distance."
      }
    },
    "strokes": {
      "title": {
        "zh": "先横线，后小点",
        "en": "First strokes, then dots"
      },
      "text": {
        "zh": "1884年，他先用一层互补色的横向小笔触打底，再加上一层小点。",
        "en": "In 1884, he began with a layer of small horizontal strokes in complementary colours, then added a layer of dots."
      }
    },
    "border": {
      "title": {
        "zh": "画出来的边框",
        "en": "A painted border"
      },
      "text": {
        "zh": "画面四周有一圈蓝、橙、红色的小点，是修拉后来加上去的，连接画面和白色的画框。",
        "en": "Around the edge is a border of blue, orange and red dots, added later, linking the picture to its white frame."
      }
    },
    "forty": {
      "title": {
        "zh": "大约40个人",
        "en": "About forty people"
      },
      "text": {
        "zh": "画面上大约有40个人物，大多是侧面或正面，好像一幅希腊古典浮雕。",
        "en": "Some 40 figures fill the canvas, mostly in profile or facing us, like a classical Greek frieze."
      }
    },
    "back": {
      "title": {
        "zh": "两年后又回来",
        "en": "Back two years later"
      },
      "text": {
        "zh": "开始画两年后，修拉又回来修改，加强了一些人物的轮廓，还加了新的人物。",
        "en": "Two years after starting, Seurat returned to the painting, strengthening some silhouettes and adding new figures."
      }
    }
  },
  "exclusive": {
