  "cards": {
    "concerts": {
      "title": {
        "zh": "每周两次的音乐会",
        "en": "Twice-weekly concerts"
      },
      "text": {
        "zh": "人们聚在杜伊勒里花园里，听每周两次的户外音乐会。",
        "en": "People have gathered in the Tuileries Gardens to hear one of the twice-weekly open-air concerts."
      }
    },
    "crowd": {
      "title": {
        "zh": "时髦的人群",
        "en": "A fashionable crowd"
      },
      "text": {
        "zh": "人群里有不少艺术家和知识分子。男人戴着黑色高礼帽，女人戴着软帽、拿着阳伞。",
        "en": "The crowd includes many artists and intellectuals. The men wear black top hats; the women, bonnets and parasols."
      }
    },
    "group": {
      "title": {
        "zh": "一幅群像",
        "en": "A group portrait"
      },
      "text": {
        "zh": "这也是一幅群像：马奈画进了自己的家人、朋友，有艺术家、作家和音乐家。",
        "en": "It is also a group portrait: Manet included his family and friends, artists, writers and musicians."
      }
    },
    "manet": {
      "title": {
        "zh": "马奈自己",
        "en": "Manet himself"
      },
      "text": {
        "zh": "画面最左边，马奈把自己也画了进去。",
        "en": "At the far left edge of the picture, Manet painted himself."
      }
    },
    "chairs": {
      "title": {
        "zh": "新的铁椅子",
        "en": "New iron chairs"
      },
      "text": {
        "zh": "前景的铁椅子，是1862年才刚刚换掉花园里原来的木椅子的。",
        "en": "The iron chairs in the foreground had only just replaced the garden's old wooden chairs in 1862."
      }
    },
    "colours": {
      "title": {
        "zh": "孩子们的颜色",
        "en": "The children's colours"
      },
      "text": {
        "zh": "孩子们的帽子和衣服上那些鲜艳的颜色，用的几乎是纯颜料：钴蓝、朱砂、铬橙。",
        "en": "The bright touches in the children's bonnets and clothes are painted in almost pure pigments: cobalt blue, vermilion, chrome orange."
      }
    },
    "modern": {
      "title": {
        "zh": "现代绘画的开始",
        "en": "The beginning of modern painting"
      },
      "text": {
        "zh": "因为它的题材和画法，这幅画被认为是现代绘画最早的例子之一。",
        "en": "Because of its subject and technique, this painting is considered one of the earliest examples of modern painting."
      }
    }
  },
