  "cards": {
    "workers": {
      "title": {
        "zh": "三个工人",
        "en": "Three workers"
      },
      "text": {
        "zh": "三个工人跪在地上，用刨子刨木地板，为地板重新上漆做准备。",
        "en": "Three workers kneel on the floor, scraping the wooden boards with planes, preparing them to be refinished."
      }
    },
    "curls": {
      "title": {
        "zh": "卷起的木屑",
        "en": "Curls of wood"
      },
      "text": {
        "zh": "他们身边散落着一卷卷刨下来的木屑。",
        "en": "Around them lie curls of wood shavings."
      }
    },
    "window": {
      "title": {
        "zh": "窗外的光",
        "en": "Light from the window"
      },
      "text": {
        "zh": "光从窗户照进来，刨过的地板闪着光，没刨过的地方颜色更暗。",
        "en": "Light streams in through the window. The scraped boards gleam; the untouched ones are darker."
      }
    },
    "down": {
      "title": {
        "zh": "往下看",
        "en": "Looking down"
      },
      "text": {
        "zh": "我们像是站在高处往下看。地板木条的线条，把视线一路引向窗户。",
        "en": "We seem to be looking down from above. The lines of the floorboards draw our eye towards the window."
      }
    },
    "drink": {
      "title": {
        "zh": "地上的酒",
        "en": "A drink on the floor"
      },
      "text": {
        "zh": "地上放着一瓶酒和一只杯子，是工人们干活时喝的。",
        "en": "On the floor stand a bottle and a glass for the workers."
      }
    },
    "subject": {
      "title": {
        "zh": "“粗俗的题材”",
        "en": "A “vulgar” subject"
      },
      "text": {
        "zh": "1875年，官方沙龙拒绝了这幅画，有评论家说，画工人干活是“粗俗的题材”。",
        "en": "In 1875, the official Salon rejected this painting; some critics called it a “vulgar subject”."
      }
    }
  },
