  "cards": {
    "mirror": {
      "title": {
        "zh": "凸面镜",
        "en": "The mirror"
      },
      "text": {
        "zh": "后墙上的凸面镜照出了整个房间，还有两个正走进门的男人，其中一个举起了手臂。",
        "en": "The convex mirror on the back wall reflects the whole room, and two men coming in at the door. One of them raises his arm."
      }
    },
    "signature": {
      "title": {
        "zh": "墙上的签名",
        "en": "The signature"
      },
      "text": {
        "zh": "镜子上方用拉丁文写着：“扬·凡·艾克来过这里。1434。”像一句涂鸦，宣告画家本人到过这里。",
        "en": "Above the mirror, in Latin: \"Jan van Eyck was here. 1434.\" Like graffiti, it announces that the painter himself was present."
      },
      "link": {
        "scene": "man-red-chaperon",
        "href": "../man-red-chaperon/",
        "label": {
          "zh": "同一个展厅",
          "en": "In the same room"
        }
      }
    },
    "beads": {
      "title": {
        "zh": "琥珀念珠",
        "en": "Amber prayer beads"
      },
      "text": {
        "zh": "墙上挂着一串橙黄色的琥珀念珠。凡·艾克连念珠在墙上的反光都画了出来。",
        "en": "A string of orange-yellow amber prayer beads hangs on the wall. Van Eyck even painted their reflections on the wall."
      }
    },
    "oranges": {
      "title": {
        "zh": "窗边的橙子",
        "en": "The oranges"
      },
      "text": {
        "zh": "窗边放着橙子。在当时的布鲁日，这是昂贵的东西。",
        "en": "Oranges lie by the window, expensive items in Bruges at the time."
      }
    },
    "chandelier": {
      "title": {
        "zh": "吊灯",
        "en": "The chandelier"
      },
      "text": {
        "zh": "天花板上挂着黄铜吊灯。可是仔细看，这个房间其实没有足够的空间放下它。",
        "en": "A brass chandelier hangs from the ceiling. Look closely, though: there isn't really enough space in the room for it."
      }
    },
    "bed": {
      "title": {
        "zh": "床",
        "en": "The bed"
      },
      "text": {
        "zh": "房间里有一张大床。在当时，床是会客室里的常见陈设，用来展示主人的财富。",
        "en": "There is a large bed in the room. At the time, beds were a normal feature of reception rooms, showing off the owner's wealth."
      }
    },
    "frame": {
      "title": {
        "zh": "镜框上的小画",
        "en": "Scenes around the mirror"
      },
      "text": {
        "zh": "镜框周围镶着一圈小画，画的是基督受难的场景。",
        "en": "The mirror's frame is set with small scenes of Christ's Passion."
      }
    }
  },
